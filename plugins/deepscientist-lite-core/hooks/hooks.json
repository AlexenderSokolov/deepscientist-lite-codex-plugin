{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/ds_lite_hook_entry.py\" user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/ds_lite_hook_entry.py\" pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/ds_lite_hook_entry.py\" post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/ds_lite_hook_entry.py\" stop"
          }
        ]
      }
    ]
  }
}
