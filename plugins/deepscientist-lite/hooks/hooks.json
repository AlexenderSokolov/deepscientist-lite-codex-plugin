{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/ds_lite_hook.py user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/ds_lite_hook.py pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/ds_lite_hook.py post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/ds_lite_hook.py stop"
          }
        ]
      }
    ]
  }
}
